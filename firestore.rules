rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 1. RESULTADOS DE TESTS
    // ============================================================
    match /testResults/{document} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ============================================================
    // 2. PERFILES DE USUARIO
    // ============================================================
    match /userProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================================
    // 3. EVENTOS DE CRISIS
    // ============================================================
    match /crisisEvents/{document} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // 4. MÓDULOS DE NEUROCIENCIAS (públicos)
    // ============================================================
    match /neuroModules/{document} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================================
    // 5. TRIVIA DE NEUROCIENCIAS (públicos)
    // ============================================================
    match /neuroTrivia/{document} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================================
    // 6. PROGRESO DE NEUROCIENCIAS (corregido)
    // ============================================================
    match /neuroProgress/{document} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // 7. MÓDULOS DE DEPORTES (públicos)
    // ============================================================
    match /deportes/{document} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================================
    // 8. TRIVIA DE DEPORTES (públicos)
    // ============================================================
    match /deportesTrivia/{document} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================================
    // 9. PROGRESO DE DEPORTES (corregido)
    // ============================================================
    match /deportesProgress/{document} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // 10. MEDITACIONES (AUDIOS) — públicos
    // ============================================================
    match /meditaciones/{document} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================================
    // 11. REGISTRO DE MEDITACIONES (solo dueño)
    // ============================================================
    match /meditacionesRegistro/{document} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // 12. LUGARES DEL MAPA (públicos, escritura autenticados)
    // ============================================================
    match /lugares/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ============================================================
    // 13. RESEÑAS (públicas, creación autenticados)
    // ============================================================
    match /resenas/{document} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================================
    // 14. MÓDULOS DE CAMINOS (públicos)
    // ============================================================
    match /caminos/{document} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================================
    // 15. TRIVIA DE CAMINOS (públicos)
    // ============================================================
    match /caminosTrivia/{document} {
      allow read: if true;
      allow write: if false;
    }

    // ============================================================
    // 16. PROGRESO DE CAMINOS (corregido)
    // ============================================================
    match /caminosProgress/{document} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // 17. DESAFÍOS (solo dueño)
    // ============================================================
    match /desafios/{document} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // 18. RACHAS (solo dueño)
    // ============================================================
    match /rachas/{document} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // ============================================================
    // 19. TOKENS DE NOTIFICACIÓN (solo dueño)
    // ============================================================
    match /tokensNotificacion/{document} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

  }
}